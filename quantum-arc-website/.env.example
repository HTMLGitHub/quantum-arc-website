# Quantum Arc Website — environment variables
#
# Copy this file to .env.local (git-ignored) and fill in real values from
# your Supabase project: Project Settings > API.
#
# VITE_SUPABASE_ANON_KEY is safe to expose in client-side code — access is
# controlled by the Row Level Security policies in supabase/blog_posts.sql,
# not by keeping this key secret.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Get this at https://web3forms.com — enter support@quantumarc.net as the
# destination email, it emails you the key. Safe to expose in client code:
# it's tied to that one destination and rate-limited on Web3Forms' end.
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
